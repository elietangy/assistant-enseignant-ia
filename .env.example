# --- Frontend (Vite) — valeurs publiques, sans risque à exposer dans le navigateur ---
VITE_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Fonction serverless Netlify — SECRÈTES, à définir uniquement dans Netlify (Site settings > Environment variables) ---
# Ne jamais committer les vraies valeurs de ce fichier.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clé service_role Supabase (Project Settings > API > service_role) — UNIQUEMENT utilisée par le
# webhook fedapay-webhook pour activer les abonnements, jamais exposée au navigateur.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# FedaPay (tableau de bord FedaPay > Développeurs > Clés API)
FEDAPAY_SECRET_KEY=sk_sandbox_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# "sandbox" pour tester, "live" pour les vrais paiements
FEDAPAY_ENV=sandbox
# Secret de signature du webhook (tableau de bord FedaPay > Développeurs > Webhooks)
FEDAPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# URL publique du site, utilisée pour le retour après paiement
SITE_URL=https://assistantenseignant.site
